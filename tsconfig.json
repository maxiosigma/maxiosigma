{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "verbatimModuleSyntax": true,
        "noImplicitOverride": true,
        "strictNullChecks": false,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strict": false
    }
}
