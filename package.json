{
   "private": true,
   "browser": {
      "fs": false,
      "path": false,
      "os": false
   },
   "type": "module",
   "scripts": {
      "dev": "nuxt",
      "strapi-dev": "cd ../strapi/ && yarn strapi develop",
      "strapi-dev-admin": "cd ../strapi/ && yarn strapi develop --watch-admin",
      "generate-start": "yarn generate && yarn start --open",
      "generate": "nuxt generate",
      "start": "SET NUXT_ENV_HOST_0=true & nuxt start",
      "open": "nuxt --open",
      "strapi-generate": "npm-run-all -l -p --silent strapi-dev generate",
      "firebase npm-run-all": "npm-run-all -l -p --silent strapi-dev firebase-deploy-generate",
      "firebase-deploy-generate": "yarn generate && yarn firebase-deploy",
      "firebase-deploy-serve": "firebase serve",
      "cooments": "--only hosting",
      "firebase-deploy-preview": "firebase hosting:channel:deploy testerium",
      "firebase-deploy": "firebase deploy --only hosting --non-interactive",
      "vercel npm-run-all": "npm-run-all --parallel strapi-dev vercel-deploy-generate",
      "vercel-deploy-generate": "yarn generate && vercel --prod",
      "strapi-build": "cd ../strapi/ && yarn strapi build",
      "apollo-download": "npx apollo schema:download --endpoint=http://localhost:1337/graphql schema.json"
   },
