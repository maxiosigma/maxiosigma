{
	"name": "meworld",
	"version": "1.0.0",
	"private": true,
	"browser": {
		"fs": false
	},
	"scripts": {
		"dev": "node download.js && nuxt",
		"slicemachine": "start-slicemachine",
		"dev-ntl": "netlify dev",
		"dev-ntl-live": "netlify dev --live",
		"dev-graph": "netlify dev --live --graph",
		"exec": "netlify dev:exec YOUR_SHELL_COMMAND",
		"generate-start-dev": "SET NUXT_ENV_GENDEV=true & SET NUXT_ENV_OPTIMIZATION=true & nuxt generate && nuxt start",
		"generate-start-prod": "npm run generate && npm run start",
		"generate-build-netly-deploy": "npm run generate && npm run netly-deploy-prod",
		"netly-deploy": "netlify deploy",
		"netly-deploy-prod": "netlify deploy --prod",
		"generate": "node download.js && nuxt generate",
		"generate-zero": "nuxt generate",
		"generate-nlf": "CI=1 nuxt generate --quiet",
		"generate-optimization": "SET NUXT_OPTIMIZATION=true & nuxt generate",
		"generate-optimization-start": "npm run generate-optimization && npm run start",
		"export": "nuxt build && nuxt export",
		"dev-localtunel": "SET NUXT_ENV_LT=true & nuxt & lt --port 8000",
		"static": "nuxt static",
		"start": "SET NUXT_ENV_HOST_0=true & nuxt start",
		"gulp-minify": "gulp",
		"netly-build-deploy": "npm run netly-build && npm run netly-deploy",
		"netly-build": "netlify build",
		"Старые зависимости": "npm-check-updates",
		"Обновить все старые зависимости": "npm-check-updates -u && npm run update",
		"Очистить кэш": "npm cache clean --force -g",
		"git-fetch": "git fetch --prune",
		"node-download": "node download.js"
	},
	"dependencies": {
