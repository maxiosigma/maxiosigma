{
    "arrowParens": "always",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "trailingComma": "none",
    "singleQuote": true,
    "printWidth": 120,
    "semi": false,
    "tabWidth": 4,
    "overrides": [
        {
            "files": ["./plugins/content-data-server.ts"],
            "options": {
                "printWidth": 1600
            }
        },
        {
            "files": ["./content/*"],
            "options": {
                "singleAttributePerLine": true,
                "printWidth": 1600
            }
        }
    ]
}
