{
	"name": "meworld",
	"version": "1.0.0",
	"private": true,
	"browser": {
		"fs": false
	},
	"scripts": {
		"dev": "nuxt",
		"dev-ntl": "netlify dev",
		"dev-ntl-live": "netlify dev --live",
		"dev-graph": "netlify dev --live --graph",
		"exec": "netlify dev:exec YOUR_SHELL_COMMAND",
		"generate-start-dev": "SET NUXT_ENV_GENDEV=true & SET NUXT_ENV_OPTIMIZATION=true & nuxt generate && nuxt start",
		"generate-start-prod": "npm run generate && npm run start",
		"generate-build-netly-deploy": "npm run generate && npm run netly-deploy-prod",
		"netly-deploy": "netlify deploy",
		"netly-deploy-prod": "netlify deploy --prod",
		"generate": "nuxt generate --no-force-exit --fail-on-error",
		"generate-nlf": "CI=1 nuxt generate --quiet",
		"generate-optimization": "SET NUXT_OPTIMIZATION=true & nuxt generate",
		"generate-optimization-start": "npm run generate-optimization && npm run start",
		"export": "nuxt build && nuxt export",
		"dev-localtunel": "SET NUXT_ENV_LT=true & nuxt & lt --port 8000",
		"static": "nuxt static",
		"start": "SET NUXT_ENV_HOST_0=true & nuxt start",
		"gulp-minify": "gulp",
		"netly-build-deploy": "npm run netly-build && npm run netly-deploy",
		"netly-build": "netlify build",
		"Старые зависимости": "npm-check-updates",
		"Обновить все старые зависимости": "npm-check-updates -u && npm run update",
		"Очистить кэш": "npm cache clean --force -g",
		"git-fetch": "git fetch --prune"
	},
	"dependencies": {
		"@nuxt-hero-icons/outline": "^1.0.1",
		"@nuxt-hero-icons/solid": "^1.0.1",
		"@nuxt/content": "^1.15.1",
		"@nuxtjs/axios": "^5.13.6",
		"@nuxtjs/dotenv": "^1.4.1",
		"@nuxtjs/i18n": "^7.2.0",
		"@nuxtjs/markdownit": "^2.0.0",
		"@nuxtjs/pwa": "^3.3.5",
		"@nuxtjs/sitemap": "^2.4.0",
		"@nuxtjs/toast": "^3.3.1",
		"@nuxtjs/universal-storage": "^0.5.9",
		"@windicss/plugin-animations": "^1.0.9",
		"@windicss/plugin-heropatterns": "0.0.8",
		"@windicss/plugin-icons": "^1.0.2",
		"@windicss/plugin-interaction-variants": "^1.0.0",
		"autoprefixer": "^10.4.2",
		"cookie-universal-nuxt": "^2.1.5",
		"core-js": "^3.21.1",
		"cross-env": "^7.0.3",
		"css-loader": "<=5.0.0",
		"data-store": "^4.0.3",
		"encoding": "^0.1.13",
		"fs": "^0.0.0",
		"glob": "^7.2.0",
		"import-postcss": "^8.0.2",
		"lottie-web": "^5.9.1",
		"markdown-it": "^12.3.2",
		"node-sass": "^7.0.0",
		"nuxt": "2.15.8",
		"nuxt-i18n-easy": "^1.5.1",
		"nuxt-user-agent": "^1.2.2",
		"nuxt-vuex-router-sync": "^0.0.3",
		"nuxt-windicss": "^2.3.1",
		"path": "^0.12.7",
		"postcss": "^8.4.8",
		"postcss-import": "<=13.0.0",
		"postcss-loader": "<=4.1.0",
		"sass": "^1.45.1",
		"sass-loader": "<=10.1.1",
		"tailwindcss-elevation": "^1.0.1",
		"vue-fb-customer-chat": "^0.2.1",
		"vue-slick-carousel": "^1.0.6",
		"vue-typed-js": "^0.1.2",
		"webpack": "^4.46.0",
		"windicss": "^3.4.0"
	},
	"devDependencies": {
		"@nuxtjs/google-analytics": "^2.4.0",
		"nuxt-animejs": "^1.2.2",
		"nuxt-fontagon": "^1.0.4",
		"nuxt-gsap-module": "^1.7.0",
		"nuxt-png-to-ico": "^0.0.3"
	}
}
